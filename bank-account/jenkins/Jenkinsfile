pipeline {
    agent any

    environment {
        // Configuration Docker
        DOCKER_REGISTRY = 'ghcr.io'
        DOCKER_IMAGE_NAME = 'bonnefoipatrick/bank-account-ia'
        
        // Configuration Kubernetes
        K8S_NAMESPACE_DEV = 'bank-account-dev'
        K8S_NAMESPACE_PROD = 'bank-account-prod'
        
        // Configuration Git
        GIT_REPO = 'https://github.com/bonnefoipatrick/bank-account-ia.git'
        
        // Version de l'image
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        
        // Configuration des scans de sécurité
        RUN_SECURITY_SCANS = "true"
        FAIL_ON_CRITICAL_VULNERABILITIES = "true"
    }

    stages {
        // Étape 1: Checkout du code
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Étape 2: Scan de sécurité du code (avant le build)
        stage('Security Scan - Code') {
            when {
                expression { env.RUN_SECURITY_SCANS == "true" }
            }
            steps {
                dir('bank-account') {
                    script {
                        echo "Exécution du scan de sécurité du code..."
                        sh '''
                            chmod +x ./scripts/security/scan-code.sh
                            ./scripts/security/scan-code.sh
                        '''
                    }
                }
            }
            post {
                always {
                    // Archiver les rapports de sécurité
                    archiveArtifacts artifacts: 'bank-account/build/reports/security/**/*', fingerprint: true
                }
            }
        }

        // Étape 3: Scan de sécurité des dépendances
        stage('Security Scan - Dependencies') {
            when {
                expression { env.RUN_SECURITY_SCANS == "true" }
            }
            steps {
                dir('bank-account') {
                    script {
                        echo "Exécution du scan de sécurité des dépendances..."
                        sh '''
                            chmod +x ./scripts/security/scan-dependencies.sh
                            ./scripts/security/scan-dependencies.sh
                        '''
                    }
                }
            }
            post {
                always {
                    // Archiver les rapports de sécurité
                    archiveArtifacts artifacts: 'bank-account/build/reports/security/**/*', fingerprint: true
                }
            }
        }

        // Étape 4: Build avec Gradle
        stage('Build') {
            steps {
                dir('bank-account') {
                    sh '''
                        # Installer Gradle si nécessaire
                        if ! command -v gradle &> /dev/null; then
                            echo "Gradle not found, trying to use wrapper..."
                            chmod +x ./gradlew
                            ./gradlew --version
                        fi
                        
                        # Build tous les modules
                        ./gradlew clean build --no-daemon --stacktrace
                    '''
                }
            }
            post {
                always {
                    # Archiver les artefacts
                    archiveArtifacts artifacts: 'bank-account/**/build/libs/*.jar', fingerprint: true
                    archiveArtifacts artifacts: 'bank-account/**/build/reports/tests/**/*.html', fingerprint: true
                }
            }
        }

        // Étape 5: Tests unitaires
        stage('Test') {
            steps {
                dir('bank-account') {
                    sh '''
                        ./gradlew test --no-daemon --stacktrace
                    '''
                }
            }
            post {
                always {
                    # Publier les résultats des tests
                    junit '**/build/test-results/**/*.xml'
                    archiveArtifacts artifacts: '**/build/reports/tests/**/*', fingerprint: true
                }
            }
        }

        // Étape 6: Tests Cucumber (BDD)
        stage('BDD Tests') {
            steps {
                dir('bank-account') {
                    sh '''
                        # Exécuter les tests Cucumber
                        ./gradlew :infrastructure:test --tests "com.bankaccount.infrastructure.RunCucumberTest" --no-daemon --stacktrace
                    '''
                }
            }
            post {
                always {
                    # Archiver les rapports Cucumber
                    archiveArtifacts artifacts: '**/target/cucumber-reports/**/*', fingerprint: true
                }
            }
        }

        // Étape 7: Tests de sécurité API
        stage('Security Tests') {
            steps {
                dir('bank-account') {
                    sh '''
                        # Exécuter les tests de sécurité
                        ./gradlew :infrastructure:test --tests "com.bankaccount.infrastructure.security.*" --no-daemon --stacktrace
                    '''
                }
            }
            post {
                always {
                    # Archiver les rapports de tests
                    archiveArtifacts artifacts: '**/build/test-results/**/*.xml', fingerprint: true
                }
            }
        }

        // Étape 8: Build de l'image Docker
        stage('Docker Build') {
            steps {
                dir('bank-account') {
                    script {
                        // Build de l'image Docker
                        sh """
                            docker build \\
                                -t ${DOCKER_IMAGE_NAME}:${IMAGE_TAG} \\
                                -t ${DOCKER_IMAGE_NAME}:latest \\
                                -f app/src/main/docker/Dockerfile \\
                                .
                        """
                        
                        // Login vers le registry (si nécessaire)
                        // withCredentials([usernamePassword(credentialsId: 'DOCKER_HUB_CREDENTIALS', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        //     sh "docker login -u \${DOCKER_USER} -p \${DOCKER_PASS} \${DOCKER_REGISTRY}"
                        // }
                        
                        // Pousser l'image (désactivé par défaut, à activer en production)
                        // sh "docker push ${DOCKER_IMAGE_NAME}:${IMAGE_TAG}"
                        // sh "docker push ${DOCKER_IMAGE_NAME}:latest"
                    }
                }
            }
        }

        // Étape 9: Scan de sécurité de l'image Docker
        stage('Security Scan - Docker Image') {
            when {
                expression { env.RUN_SECURITY_SCANS == "true" }
            }
            steps {
                dir('bank-account') {
                    script {
                        echo "Exécution du scan de sécurité de l'image Docker..."
                        sh '''
                            chmod +x ./scripts/security/scan-docker.sh
                            ./scripts/security/scan-docker.sh
                        '''
                    }
                }
            }
            post {
                always {
                    // Archiver les rapports de sécurité
                    archiveArtifacts artifacts: 'bank-account/build/reports/security/**/*', fingerprint: true
                }
            }
        }

        // Étape 10: Déploiement en développement (optionnel)
        stage('Deploy to Dev') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "Déploiement en développement..."
                    // Utiliser kubectl ou ArgoCD CLI pour déclencher le déploiement
                    sh """
                        # Mettre à jour l'image dans le manifest Kubernetes
                        # kubectl set image deployment/bank-account-app bank-account-app=${DOCKER_IMAGE_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE_DEV}
                        
                        # Ou utiliser ArgoCD pour synchroniser
                        # argocd app sync bank-account-dev
                        
                        echo "Pour déployer manuellement avec ArgoCD:"
                        echo "argocd app sync bank-account-dev"
                    """
                }
            }
        }

        // Étape 11: Déploiement en production (manuel)
        stage('Deploy to Prod') {
            when {
                branch 'main'
                // expression { currentBuild.result == 'SUCCESS' }
            }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: 'Confirmer le déploiement en production?', ok: 'Deploy'
                    script {
                        echo "Déploiement en production..."
                        sh """
                            # kubectl set image deployment/bank-account-app bank-account-app=${DOCKER_IMAGE_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE_PROD}
                            # argocd app sync bank-account-prod
                            echo "Pour déployer manuellement avec ArgoCD:"
                            echo "argocd app sync bank-account-prod"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            // Nettoyer l'espace de travail
            cleanWs()
            
            // Envoyer une notification si le build échoue
            if (currentBuild.result == 'FAILURE') {
                echo "Le pipeline a échoué!"
                // Ici, vous pourriez ajouter une notification Slack/Email
                // slackSend channel: '#devops', message: "Build échoué: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
            }
        }
        success {
            echo 'Pipeline terminé avec succès!'
            // Notification de succès
            // slackSend channel: '#devops', message: "Build réussi: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
        failure {
            echo 'Pipeline échoué!'
            // Notification d'échec
        }
    }
}
